{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Janelas do RustZIP (gerenciador e tarefas): eventos de progresso, seletores de arquivo/pasta e controle da janela.",
  "windows": ["main", "task-*"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-minimize",
    "core:window:allow-set-title",
    "core:window:allow-set-size",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask"
  ]
}
